# apps/services-fastapi (intelligence/risk/AI)
APP_NAME=dBaronX FastAPI
APP_ENV=development
ENVIRONMENT=development
NODE_ENV=development
APP_VERSION=1.0.0

HOST=0.0.0.0
PORT=8080
FORWARDED_ALLOW_IPS=*
WEB_CONCURRENCY=1
LOG_LEVEL=INFO
APP_DOCS_ENABLED=true

FRONTEND_URL=http://localhost:3000
NESTJS_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
INTERNAL_SERVICE_TOKEN=
FASTAPI_INTERNAL_SERVICE_TOKEN=
JWT_SECRET=replace-with-jwt-secret-min-16
JWT_ALGORITHM=HS256

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=

# AI providers (at least one if AI endpoints are enabled)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
AI_PROVIDER_TIMEOUT_SECONDS=45

# Risk / anti-abuse
HCAPTCHA_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
CAPTCHA_PRIMARY=hcaptcha
CAPTCHA_FALLBACK=turnstile
CAPTCHA_REQUIRED_FOR_CHECKOUT=false
CAPTCHA_REQUIRED_FOR_WATCH_REWARD=true
MFA_REQUIRED_FOR_ADMIN=true
PASSKEYS_ENABLED=false
CLOUDFLARE_TURNSTILE_SECRET=
REQUEST_TIMEOUT_SECONDS=20
RISK_CACHE_TTL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=900
MAX_REQUEST_BODY_BYTES=2097152
WATCH_MIN_DURATION_SECONDS=5
RISK_DEFAULT_ALLOW_ON_DEPENDENCY_FAILURE=true
FASTAPI_STRICT_ROUTE_MOUNT=true

# Crypto/RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DBX_SOLANA_RPC_URL=

# Render metadata (injected by platform)
RENDER_SERVICE_ID=
RENDER_SERVICE_NAME=
RENDER_INSTANCE_ID=
RENDER_GIT_COMMIT=
RENDER_EXTERNAL_HOSTNAME=
