# apps/api (NestJS economic brain)
NODE_ENV=development
PORT=3001
APP_NAME=dBaronX API
APP_URL=http://localhost:3001
APP_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
API_PREFIX=api
SWAGGER_ENABLED=true
ENABLE_SWAGGER=true
CORS_ORIGINS=http://localhost:3000
TELEGRAM_BOT_URL=http://localhost:8090

# Internal service wiring
FASTAPI_BASE_URL=http://localhost:8080
INTERNAL_SERVICE_TOKEN=
FASTAPI_TIMEOUT_MS=20000
FASTAPI_RETRY_ATTEMPTS=1
FASTAPI_FRAUD_SCORE_PATH=/fraud/score
FASTAPI_AI_PATH=/ai

# Commerce wiring
MEDUSA_BASE_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_ADMIN_API_KEY=
MEDUSA_TIMEOUT_MS=20000
MEDUSA_RETRY_ATTEMPTS=1
MEDUSA_DEFAULT_REGION_ID=
MEDUSA_ORDER_SYNC_ENABLED=true

# Data stores
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_FAIL_FAST=false
REDIS_URL=

# Auth / runtime controls
JWT_SECRET=replace-with-jwt-secret
JWT_EXPIRES=1d
REQUEST_TIMEOUT_MS=20000
CACHE_TTL_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
DBX_PAYMENT_WORKERS_ENABLED=false
MAINTENANCE_MODE=false
BLOCKED_IPS=
DEBUG_LOGS=false
LOG_DEBUG=false

# Optional providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET=
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
COINBASE_API_KEY=
EMAIL_API_KEY=
EMAIL_SENDER=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
AWS_BUCKET=
FILES_DIR=
NESTJS_API_URL=https://api.dbaronx.com
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
SUPPLIER_LIVE_MODE=false
CJ_ACCESS_TOKEN=
CJ_API_BASE_URL=
CJ_TEST_PRODUCT_ID=
CJ_TEST_SKU=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_API_BASE_URL=

# API gateway security ladder controls
CAPTCHA_REQUIRED_FOR_CHECKOUT=false
CAPTCHA_REQUIRED_FOR_WATCH_REWARD=true
MFA_REQUIRED_FOR_ADMIN=true
PASSKEYS_ENABLED=false
