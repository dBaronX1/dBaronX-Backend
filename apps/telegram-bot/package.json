{
  "name": "dbaronx-telegram-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "python -m compileall src",
    "typecheck": "python -m compileall src",
    "dev": "uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8081}",
    "start": "uvicorn src.main:app --host 0.0.0.0 --port ${PORT:-8081}",
    "deps:install": "python -m pip install -r requirements.txt",
    "smoke:runtime": "python -m compileall src"
  }
}
