# Service
APP_NAME=dbaronx-telegram-bot
ENVIRONMENT=development
LOG_LEVEL=INFO

# Telegram runtime
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# Recommended for production webhook validation.
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret
# Comma-separated Telegram user IDs allowed through admin guard.
TELEGRAM_ADMIN_IDS=

# Backend API surfaces (bot is orchestration-only)
NESTJS_BASE_URL=http://localhost:3001
FASTAPI_BASE_URL=http://localhost:8000
INTERNAL_SERVICE_TOKEN=replace-with-internal-service-token

# HTTP and webhook hardening
REQUEST_TIMEOUT_SECONDS=20
ENABLE_WEBHOOK_SIGNATURE_CHECK=false
MAX_WEBHOOK_BODY_BYTES=1048576
