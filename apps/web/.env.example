# apps/web (Next.js frontend)
NODE_ENV=development
SERVICE_NAME=dbaronx-web
DEBUG_LOGS=false

# Public browser/server URLs
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_NESTJS_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_NEST_API_URL=http://localhost:3001

# Server-side fallback URL for route handlers
NEST_API_URL=http://localhost:3001
NEST_API_TIMEOUT_MS=20000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
NEXT_PUBLIC_FASTAPI_BASE_URL=https://fastapi.dbaronx.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
NESTJS_API_URL=https://api.dbaronx.com

# Optional buyer bot protection widget config
TURNSTILE_SITE_KEY=
CAPTCHA_PRIMARY=hcaptcha
CAPTCHA_FALLBACK=turnstile
CAPTCHA_REQUIRED_FOR_CHECKOUT=false
