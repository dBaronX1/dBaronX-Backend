# apps/web (Next.js frontend)
NODE_ENV=development
SERVICE_NAME=dbaronx-web
DEBUG_LOGS=false

# Public browser/server URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_NESTJS_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_NEST_API_URL=http://localhost:3001

# Server-side fallback URL for route handlers
NEST_API_URL=http://localhost:3001
NEST_API_TIMEOUT_MS=20000
