{
  "name": "@dbaronx/medusa",
  "version": "0.0.1",
  "private": true,
  "description": "dBaronX commerce-only Medusa backend.",
  "author": "dBaronX",
  "license": "UNLICENSED",
  "keywords": [
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa",
    "dbaronx"
  ],
  "scripts": {
    "build": "pnpm exec medusa build",
    "seed": "pnpm exec medusa exec ./src/scripts/seed.ts",
    "key:publishable": "pnpm exec medusa exec ./src/scripts/ensure-publishable-api-key.ts",
    "start": "pnpm exec medusa start",
    "dev": "pnpm exec medusa develop",
    "lint": "echo \"No Medusa lint configured\"",
    "typecheck": "tsc --noEmit",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "seed:products": "pnpm exec medusa exec ./src/scripts/seed-products.ts",
    "seed:products:dry-run": "DRY_RUN=true pnpm exec medusa exec ./src/scripts/seed-products.ts",
    "stock:ensure": "pnpm exec medusa exec ./src/scripts/ensure-stock-location.ts",
    "region:ensure": "pnpm exec medusa exec ./src/scripts/ensure-region.ts",
    "shipping:ensure": "pnpm exec medusa exec ./src/scripts/ensure-shipping.ts",
    "commerce:ensure": "pnpm exec medusa exec ./src/scripts/ensure-commerce-prerequisites.ts",
    "channel:stock:ensure": "pnpm exec medusa exec ./src/scripts/ensure-sales-channel-stock-location.ts",
    "variant:inventory:ensure": "pnpm exec medusa exec ./src/scripts/ensure-variant-inventory-link.ts",
    "shipping:visibility:diagnose": "pnpm exec medusa exec ./src/scripts/diagnose-shipping-option-visibility.ts",
    "store:shipping:verify": "pnpm exec medusa exec ./src/scripts/verify-store-shipping-options.ts",
    "first-product:seed": "pnpm exec medusa exec ./src/scripts/seed-first-real-supplier-product.ts",
    "first-product:seed:cj-shirt": "pnpm exec medusa exec ./src/scripts/seed-cj-first-shirt-product.ts",
    "db:migrate": "pnpm exec medusa db:migrate",
    "medusa:db:migrate": "pnpm exec medusa db:migrate",
    "db:health": "pnpm exec ts-node --swc ./src/scripts/check-medusa-db-core-readiness.ts",
    "medusa:db:health": "pnpm exec ts-node --swc ./src/scripts/check-medusa-db-core-readiness.ts",
    "db:prepare": "pnpm run db:migrate && pnpm run db:health",
    "db:prepare:fresh": "pnpm run db:prepare",
    "first-product:readiness": "node ../../scripts/e2e-first-real-supplier-product-readiness-smoke.mjs",
    "controlled-cj:seed": "pnpm exec medusa exec ./src/scripts/seed-controlled-cj-products.ts",
    "publishable-key:ensure": "pnpm exec medusa exec ./src/scripts/ensure-publishable-api-key.ts",
    "fresh-db:commerce:ensure": "pnpm exec medusa exec ./src/scripts/ensure-fresh-db-launch-commerce.ts",
    "launch-commerce:ensure": "pnpm exec medusa exec ./src/scripts/ensure-fresh-db-launch-commerce.ts"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.13.6",
    "@medusajs/cli": "2.13.6",
    "@medusajs/dashboard": "2.13.6",
    "@medusajs/framework": "2.13.6",
    "@medusajs/medusa": "2.13.6"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.13.6",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=20 <21"
  },
  "packageManager": "pnpm@10.0.0"
}
