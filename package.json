{
  "name": "dbaronx",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check:python": "python -m compileall apps/services-fastapi/src apps/telegram-bot/src",
    "check:repo": "python .dbx-tools/scan_oversized_source_files.py && python .dbx-tools/scan_real_repo_pollution.py",
    "check:env-contracts": "node scripts/check-env-contracts.mjs",
    "security:readiness": "node scripts/security-readiness-check.mjs",
    "first-product:seed": "pnpm --filter @dbaronx/medusa first-product:seed",
    "first-product:readiness": "node scripts/e2e-first-real-supplier-product-readiness-smoke.mjs",
    "first-sale:readiness": "node scripts/e2e-first-real-sale-readiness-closure.mjs",
    "first-product:seed:cj-shirt": "pnpm --filter @dbaronx/medusa first-product:seed:cj-shirt",
    "first-product:render-seed-command": "node scripts/print-cj-first-shirt-render-seed-command.mjs",
    "deploy:fly:telegram": "flyctl deploy --config apps/telegram-bot/fly.toml --app dbaronx-telegram-bot",
    "deploy:fly:fastapi": "flyctl deploy --config apps/services-fastapi/fly.toml --app dbaronx-fastapi",
    "deploy:fly:web": "flyctl deploy --config apps/web/fly.toml --app dbaronx-web",
    "deploy:fly:telegram:build-only": "flyctl deploy --config apps/telegram-bot/fly.toml --app dbaronx-telegram-bot --build-only --push",
    "deploy:fly:fastapi:build-only": "flyctl deploy --config apps/services-fastapi/fly.toml --app dbaronx-fastapi --build-only --push",
    "deploy:fly:web:build-only": "flyctl deploy --config apps/web/fly.toml --app dbaronx-web --build-only --push",
    "deploy:fly:runtime-services": "pnpm deploy:fly:telegram && pnpm deploy:fly:fastapi",
    "release:first-transaction:smokes": "pnpm runtime:fly:readiness && pnpm first-product:readiness && node scripts/e2e-telegram-customer-first-checkout-journey-smoke.mjs && node scripts/e2e-first-stripe-test-transaction-smoke.mjs && node scripts/e2e-first-transaction-with-telegram-ops-smoke.mjs",
    "first-transaction:commands": "node scripts/print-first-transaction-final-commands.mjs",
    "runtime:fly:readiness": "node scripts/e2e-fly-runtime-release-readiness-smoke.mjs",
    "web:auth:readiness": "node scripts/e2e-web-auth-runtime-config-smoke.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core"
    ]
  }
}
