{
  "name": "dbaronx",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "check:python": "python -m compileall apps/services-fastapi/src apps/telegram-bot/src",
    "check:repo": "python .dbx-tools/scan_oversized_source_files.py && python .dbx-tools/scan_real_repo_pollution.py",
    "check:env-contracts": "node scripts/check-env-contracts.mjs",
    "security:readiness": "node scripts/security-readiness-check.mjs",
    "first-product:seed": "pnpm --filter @dbaronx/medusa first-product:seed",
    "first-product:readiness": "node scripts/e2e-first-real-supplier-product-readiness-smoke.mjs",
    "first-sale:readiness": "node scripts/e2e-first-real-sale-readiness-closure.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core"
    ]
  }
}
