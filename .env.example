# dBaronX unified monorepo root environment contract
# Copy to .env only if you run tooling from repo root.

# ---------- Shared runtime ----------
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=INFO
INTERNAL_SERVICE_TOKEN=replace-with-at-least-20-chars

# ---------- Service URLs ----------
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
FASTAPI_BASE_URL=http://localhost:8080
MEDUSA_BASE_URL=http://localhost:9000
TELEGRAM_BOT_URL=http://localhost:8090

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# ---------- API/NestJS ----------
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-jwt-secret-min-20
JWT_EXPIRES=1d

# ---------- FastAPI ----------
FRONTEND_URL=http://localhost:3000
NESTJS_BASE_URL=http://localhost:3001
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------- Medusa ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7000
AUTH_CORS=http://localhost:3000,http://localhost:7000
COOKIE_SECRET=replace-with-cookie-secret
MEDUSA_BACKEND_URL=http://localhost:9000

# ---------- Telegram bot ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
# ---------- Payments / checkout ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_DBX_SOLANA_PAYMENT_ADDRESS=

NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
# ---------- Supplier credentials (server-only API env; keep blank locally unless approved) ----------
CJ_ACCESS_TOKEN=
CJ_API_BASE_URL=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_API_BASE_URL=
