# dBaronX unified monorepo root environment contract
# Copy to .env only if you run tooling from repo root.

# ---------- Shared runtime ----------
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=INFO
INTERNAL_SERVICE_TOKEN=

# ---------- Service URLs ----------
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
FASTAPI_BASE_URL=http://localhost:8080
MEDUSA_BASE_URL=http://localhost:9000
TELEGRAM_BOT_URL=http://localhost:8090

# ---------- Supabase ----------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# ---------- API/NestJS ----------
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-jwt-secret-min-20
JWT_EXPIRES=1d

# ---------- FastAPI ----------
FRONTEND_URL=http://localhost:3000
NESTJS_BASE_URL=http://localhost:3001
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---------- Medusa ----------
DATABASE_URL=
REDIS_URL=redis://localhost:6379
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7000
AUTH_CORS=http://localhost:3000,http://localhost:7000
COOKIE_SECRET=replace-with-cookie-secret
MEDUSA_BACKEND_URL=http://localhost:9000

# ---------- Telegram bot ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
TELEGRAM_ALLOWED_ADMIN_IDS=
TELEGRAM_ADMIN_ROLES=
TELEGRAM_BOT_PUBLIC_BASE_URL=
# ---------- Payments / checkout ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_DBX_SOLANA_PAYMENT_ADDRESS=

NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_MEDUSA_BACKEND_URL=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# ---------- Suppliers / server-only API env ----------
CJ_ACCESS_TOKEN=
CJ_API_BASE_URL=
CJ_TEST_PRODUCT_ID=
CJ_TEST_SKU=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_API_BASE_URL=

# ---------- First-sale CAPTCHA / step-up security ladder ----------
HCAPTCHA_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
CAPTCHA_PRIMARY=hcaptcha
CAPTCHA_FALLBACK=turnstile
CAPTCHA_REQUIRED_FOR_CHECKOUT=false
CAPTCHA_REQUIRED_FOR_WATCH_REWARD=true
MFA_REQUIRED_FOR_ADMIN=true
PASSKEYS_ENABLED=false
